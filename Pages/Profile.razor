@page "/profile"
@inject AuthService AuthService
@inject NavigationManager Nav

<h3>Perfil</h3>

@if (mensajeError is not null)
{
    <div class="alert alert-danger">@mensajeError</div>
}
else if (user is null)
{
    <p>Loading...</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">UsuarioId</dt><dd class="col-sm-9">@user.UsuarioId</dd>
        <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@user.PrimerNombre @user.PrimerApellido</dd>
        <dt class="col-sm-3">Correo</dt><dd class="col-sm-9">@user.CorreoElectronico</dd>
    </dl>
}

@code {
    private AuthService.UserInfo? user;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = await AuthService.GetCurrentUserAsync();
        }
        catch (SesionExpiradaException)
        {
            Nav.NavigateTo("login");
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo cargar el perfil: {ex.Message}";
        }
    }
}