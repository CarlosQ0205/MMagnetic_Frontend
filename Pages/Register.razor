@page "/register"
@inject AuthService AuthService
@inject NavigationManager Nav

<h3>Registro de Usuario</h3>

<div class="mb-3">
    <label>Tipo Documento</label>
    <input class="form-control" @bind="tipoDocumento" />
</div>
<div class="mb-3">
    <label>Numero Documento</label>
    <input class="form-control" @bind="numeroDocumento" />
</div>
<div class="mb-3">
    <label>Primer Nombre</label>
    <input class="form-control" @bind="primerNombre" />
</div>
<div class="mb-3">
    <label>Primer Apellido</label>
    <input class="form-control" @bind="primerApellido" />
</div>
<div class="mb-3">
    <label>Correo Electronico</label>
    <input class="form-control" @bind="correo" />
</div>
<div class="mb-3">
    <label>Password</label>
    <input type="password" class="form-control" @bind="password" />
</div>

<button class="btn btn-success" @onclick="OnRegisterClicked">Registrar</button>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}
@if (successMessage != null)
{
    <div class="alert alert-success mt-3">@successMessage</div>
}

@code {
    private string tipoDocumento = "CC";
    private string numeroDocumento = "";
    private string primerNombre = "";
    private string primerApellido = "";
    private string correo = "";
    private string password = "";
    private string errorMessage = "";
    private string? successMessage;

    private async Task OnRegisterClicked()
    {
        errorMessage = string.Empty;
        successMessage = null;

        try
        {
            var request = new AuthService.RegisterRequest(tipoDocumento, numeroDocumento, primerNombre, primerApellido, correo, password);
            await AuthService.RegisterAsync(request);
            successMessage = "Registro exitoso. Ya puedes iniciar sesión.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}