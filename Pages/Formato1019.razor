@page "/formato1019"
@attribute [Authorize(Roles = "Admin")]
@inject ExogenaApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<h3>Formato 1019 (DIAN)</h3>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Período (año)</label>
                <input type="number" class="form-control" @bind="periodoAno" />
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button class="btn btn-f1019" disabled="@clasificando" @onclick="ClasificarAsync">
                @(clasificando ? "Creando..." : "Crear Formato 1019")
            </button>
            <button class="btn btn-f1019" disabled="@descargando" @onclick="DescargarStagingAsync">
                Descarga Formato 1019
            </button>
            <button class="btn btn-f1019" disabled="@borrando" @onclick="BorrarPeriodoAsync">
                @(borrando ? "Borrando..." : "Borra tabla Formato 1019")
            </button>
            <button class="btn btn-f1019" disabled="@descargando" @onclick="DescargarErroresAsync">
                Descarga errores F-1019
            </button>
            <button class="btn btn-f1019" @onclick="ToggleSubirCorregidos">
                Subir corregidos F-1019
            </button>
            <button class="btn btn-f1019" @onclick="ToggleGenerarXml">
                Descargar F-1019 definitivo
            </button>
        </div>

        @if (resumen is not null)
        {
            <div class="alert @(resumen.ConErrores == 0 ? "alert-success" : "alert-warning") mt-3">
                Total: @resumen.TotalRegistros — Válidos: @resumen.Validos — Con errores: @resumen.ConErrores
            </div>
        }

        @if (mensajeInfo is not null)
        {
            <div class="alert alert-success mt-3">@mensajeInfo</div>
        }

        @if (mensajeError is not null)
        {
            <div class="alert alert-danger mt-3">@mensajeError</div>
        }
    </div>
</div>

@if (mostrarSubirCorregidos)
{
    <div class="card mb-4">
        <div class="card-header">Subir corregidos F-1019</div>
        <div class="card-body">
            <p class="text-muted">
                Toma el mismo Excel que descargaste en <strong>Descarga errores F-1019</strong> — ya trae la línea
                completa de cada cuenta con problema (datos del cliente y datos financieros en una sola fila) más
                la columna "Errores". Corrígelo ahí y súbelo tal cual aquí; no hace falta separarlo por tabla.
                Luego vuelve a apretar "Crear Formato 1019" arriba — reemplaza el resultado anterior sin duplicar.
            </p>

            <InputFile OnChange="CargarCorregidosAsync" accept=".xlsx,.csv" disabled="@cargandoArchivo" />

            @if (resultadoCarga is not null)
            {
                <div class="alert @(resultadoCarga.ConErrores == 0 ? "alert-success" : "alert-warning") mt-3">
                    Total: @resultadoCarga.TotalFilas — Exitosas: @resultadoCarga.Exitosas — Con errores: @resultadoCarga.ConErrores
                </div>

                @if (resultadoCarga.Errores.Count > 0)
                {
                    <table class="table table-sm">
                        <thead><tr><th>Fila</th><th>Error</th></tr></thead>
                        <tbody>
                            @foreach (var error in resultadoCarga.Errores)
                            {
                                <tr><td>@error.Fila</td><td>@error.Mensaje</td></tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>
    </div>
}

@if (resumen is not null || staging.Count > 0 || errores.Count > 0 || definitivo.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item"><a class="nav-link @(tab == "staging" ? "active" : "")" href="" @onclick:preventDefault @onclick='() => tab = "staging"'>Formato_1019 (@staging.Count)</a></li>
                <li class="nav-item"><a class="nav-link @(tab == "errores" ? "active" : "")" href="" @onclick:preventDefault @onclick='() => tab = "errores"'>Formato_Errores (@errores.Count)</a></li>
                <li class="nav-item"><a class="nav-link @(tab == "definitivo" ? "active" : "")" href="" @onclick:preventDefault @onclick='() => tab = "definitivo"'>F_1019_Definitivo (@definitivo.Count)</a></li>
            </ul>
        </div>
        <div class="card-body">
            @if (cargandoTablas)
            {
                <p>Cargando...</p>
            }
            else if (tab == "staging")
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead><tr><th>Cliente</th><th>Cuenta</th><th>Concepto</th><th>Valor</th></tr></thead>
                        <tbody>
                            @foreach (var fila in staging)
                            {
                                <tr><td>@fila.NumeroDocumentoCliente</td><td>@fila.Linea</td><td>@fila.CodigoConcepto</td><td>@fila.Valor</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (tab == "errores")
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead><tr><th>Cliente</th><th>Código error</th><th>Descripción</th><th>Contexto</th></tr></thead>
                        <tbody>
                            @foreach (var fila in errores)
                            {
                                <tr><td>@fila.NumeroDocumentoCliente</td><td>@fila.CodigoError</td><td>@fila.DescripcionError</td><td>@fila.ValorInvalido</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead><tr><th>Cliente</th><th>Cuenta</th><th>Concepto</th><th>Valor</th></tr></thead>
                        <tbody>
                            @foreach (var fila in definitivo)
                            {
                                <tr><td>@fila.NumeroDocumentoCliente</td><td>@fila.Linea</td><td>@fila.CodigoConcepto</td><td>@fila.Valor</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (mostrarGenerarXml)
{
    <div class="card">
        <div class="card-header">Generar archivo XML final para la DIAN</div>
        <div class="card-body">
            <p class="text-muted">
                Genera F_1019_Definitivo del período completo, dividido en archivos de máximo
                5.000 registros cada uno (el límite del Anexo 2 por envío), comprimidos en un
                .zip. Descárgalo en el formato que necesites y pásalo por el pre-validador de
                la DIAN, que es donde se asignan el número de envío, el concepto y las fechas.
            </p>

            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-f1019" disabled="@exportando" @onclick="DescargarLotesXmlAsync">
                    @(exportando ? "Generando..." : "Descargar en XML")
                </button>
                <button class="btn btn-f1019" disabled="@exportando" @onclick="DescargarLotesExcelAsync">
                    @(exportando ? "Generando..." : "Descargar en Excel")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private int periodoAno = DateTime.UtcNow.Year;
    private bool clasificando;
    private bool descargando;
    private bool borrando;
    private ResumenClasificacion? resumen;
    private string? mensajeError;
    private string? mensajeInfo;

    private bool mostrarSubirCorregidos;
    private bool cargandoArchivo;
    private ResultadoCargaMasiva? resultadoCarga;

    private string tab = "staging";
    private bool cargandoTablas;
    private List<Formato1019ConceptoDto> staging = new();
    private List<ErrorFormato1019Dto> errores = new();
    private List<Formato1019ConceptoDto> definitivo = new();

    private bool exportando;
    private bool mostrarGenerarXml;

    private async Task ClasificarAsync()
    {
        clasificando = true;
        mensajeError = null;
        mensajeInfo = null;
        resumen = null;
        try
        {
            resumen = await Api.ClasificarAsync(periodoAno);
            await CargarTablasAsync();
        }
        catch (SesionExpiradaException)
        {
            Nav.NavigateTo("login");
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo clasificar el período: {ex.Message}";
        }
        finally
        {
            clasificando = false;
        }
    }

    private async Task BorrarPeriodoAsync()
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm",
            $"¿Seguro que quieres borrar Formato_1019, Formato_Errores y F_1019_Definitivo del período {periodoAno}? Esta acción no se puede deshacer.");
        if (!confirmado)
            return;

        borrando = true;
        mensajeError = null;
        mensajeInfo = null;
        try
        {
            await Api.LimpiarPeriodoAsync(periodoAno);
            resumen = null;
            staging = new();
            errores = new();
            definitivo = new();
            mensajeInfo = $"Se borró el resultado del período {periodoAno}. Puedes volver a apretar \"Crear Formato 1019\" para rehacer el proceso.";
        }
        catch (SesionExpiradaException)
        {
            Nav.NavigateTo("login");
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo borrar el período: {ex.Message}";
        }
        finally
        {
            borrando = false;
        }
    }

    private void ToggleSubirCorregidos()
    {
        mostrarSubirCorregidos = !mostrarSubirCorregidos;
    }

    private async Task CargarCorregidosAsync(InputFileChangeEventArgs e)
    {
        cargandoArchivo = true;
        resultadoCarga = null;
        mensajeError = null;
        try
        {
            resultadoCarga = await Api.CargarCorregidosF1019Async(e.File);
        }
        catch (SesionExpiradaException)
        {
            Nav.NavigateTo("login");
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo procesar el archivo de corregidos: {ex.Message}";
        }
        finally
        {
            cargandoArchivo = false;
        }
    }

    private async Task CargarTablasAsync()
    {
        cargandoTablas = true;
        try
        {
            staging = await Api.ObtenerStagingAsync(periodoAno);
            errores = await Api.ObtenerErroresAsync(periodoAno);
            definitivo = await Api.ObtenerDefinitivoAsync(periodoAno);
        }
        catch (SesionExpiradaException)
        {
            Nav.NavigateTo("login");
        }
        finally
        {
            cargandoTablas = false;
        }
    }

    private Task DescargarStagingAsync() => DescargarAsync(Api.DescargarStagingAsync, "Formato_1019");
    private Task DescargarErroresAsync() => DescargarAsync(Api.DescargarErroresAsync, "Formato_Errores");

    private void ToggleGenerarXml()
    {
        mostrarGenerarXml = !mostrarGenerarXml;
    }

    private Task DescargarLotesXmlAsync() => DescargarAsync(Api.DescargarLotesXmlAsync, "F-1019 definitivo en XML", esLote: true);
    private Task DescargarLotesExcelAsync() => DescargarAsync(Api.DescargarLotesExcelAsync, "F-1019 definitivo en Excel", esLote: true);

    private async Task DescargarAsync(
        Func<int, Task<(byte[] Contenido, string NombreArchivo)>> descarga, string etiqueta, bool esLote = false)
    {
        if (esLote) exportando = true; else descargando = true;
        mensajeError = null;
        try
        {
            var (contenido, nombreArchivo) = await descarga(periodoAno);
            var tipoContenido = nombreArchivo.EndsWith(".zip", StringComparison.OrdinalIgnoreCase)
                ? "application/zip"
                : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            await JS.InvokeVoidAsync("descargarArchivo", nombreArchivo, tipoContenido, Convert.ToBase64String(contenido));
        }
        catch (SesionExpiradaException)
        {
            Nav.NavigateTo("login");
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo descargar {etiqueta}: {ex.Message}";
        }
        finally
        {
            if (esLote) exportando = false; else descargando = false;
        }
    }
}
